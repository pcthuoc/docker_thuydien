# ── Ứng dụng Django ──────────────────────────────────────
# Sinh SECRET_KEY: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=THAY_THE_BANG_KHOA_BI_MAT_NGAU_NHIEN

DEBUG=0
HOST=ten-domain-cua-ban.com
CSRF_TRUSTED_ORIGINS=https://ten-domain-cua-ban.com

# ── Redis ────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_URL=redis://redis:6379/2

# ── MQTT Broker ──────────────────────────────────────────
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_USER=admin
MQTT_PASS=THAY_THE_BANG_MAT_KHAU_MQTT

# ── Celery ───────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── API Keys (tuỳ chọn) ──────────────────────────────────
GOONG_MAPTILES_KEY=
METEOBLUE_API_KEY=
